{
  "name": "kontana",
  "type": "module",
  "version": "0.1.2",
  "scripts": {
    "dev": "sh -c 'hugo server -s site -p ${PORT:-1313} --disableFastRender'",
    "build": "npm run vendor:pdf-lib && hugo -s site",
    "test": "node --test",
    "vendor:pdf-lib": "cp node_modules/pdf-lib/dist/pdf-lib.min.js site/static/lib/pdf-lib.min.js",
    "postinstall": "npm run vendor:pdf-lib"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "wrangler": "^4.62.0"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/plasticrutherfordium/getkontana.git"
  },
  "homepage": "https://getkontana.com/"
}
